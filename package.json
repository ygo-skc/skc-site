{
	"name": "skc-site",
	"version": "3.1.0",
	"description": "Website to help duelists.",
	"main": "index.js",
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/icons-material": "9.5.0",
		"@mui/material": "9.5.0",
		"@nivo/pie": "0.99.0",
		"axios": "1.21.0",
		"entities": "9.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"react-router-dom": "7.18.5",
		"skc-rcl": "2.0.1"
	},
	"resolutions": {
		"d3-color": "3.1.0",
		"async": "3.2.6",
		"glob-parent": "6.0.2",
		"node-forge": "1.4.2",
		"nth-check": "3.0.1",
		"socket.io-parser": "4.2.7",
		"postcss": "8.5.32",
		"browserslist": "4.29.5",
		"react-is": "19.3.1",
		"ws": "8.22.0",
		"send": "1.2.1",
		"cross-spawn": "7.0.6",
		"js-yaml": "5.5.0",
		"express": "5.3.0",
		"mdast-util-to-hast": "13.2.1",
		"@tootallnate/once": "3.0.1",
		"handlebars": "4.7.10",
		"fast-uri": "4.2.3",
		"qs": "6.17.1"
	},
	"scripts": {
		"fresh-install": "rm -rf node_modules yarn.lock && yarn install && npx browserslist@latest --update-db",
		"start": "webpack-dev-server --mode development --env dev",
		"start:dashboard": "webpack-dashboard -- webpack serve --mode development --env dev --env dashboard",
		"build": "webpack --mode production --env dev",
		"build:development_remote": "webpack --mode production --env remote-dev",
		"build:production": "webpack --mode production --env prod",
		"test": "jest --coverage --watchAll",
		"ci:test": "jest --ci --coverage --watchAll=false",
		"lint": "eslint src --ext .tsx,.ts",
		"mutation": "stryker run config/stryker.conf.json",
		"aws:check-skc-cloudfront": "aws cloudfront list-distributions | jq '.DistributionList.Items[] | select(.Aliases.Items | contains([\"thesupremekingscastle.com\"])) |  {id: .Id, aliases: .Aliases}'",
		"deploy:prod": "yarn run build:production && bash deploy-s3.sh yugiohsite ${YGO_CLOUDFRONT_PROD}",
		"deploy:dev": "yarn run build:development_remote && bash deploy-s3.sh yugiohsitedev ${YGO_CLOUDFRONT_DEV}",
		"deploy:ec2-dev": "yarn run build:development_remote; bash deploy.sh ${SKC_SERVER}"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"devDependencies": {
		"@babel/core": "8.0.10",
		"@babel/preset-env": "8.0.7",
		"@babel/preset-react": "8.0.1",
		"@babel/preset-typescript": "8.0.7",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/jest-runner": "10.1.1",
		"@stryker-mutator/typescript-checker": "10.1.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/jest": "30.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"babel-jest": "30.5.2",
		"babel-loader": "10.1.1",
		"copy-webpack-plugin": "14.0.0",
		"css-loader": "7.1.5",
		"eslint": "10.14.0",
		"eslint-plugin-react": "7.37.5",
		"fork-ts-checker-webpack-plugin": "9.1.0",
		"globals": "17.13.0",
		"html-webpack-plugin": "5.6.8",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"jest-location-mock": "4.0.1",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-normalize": "13.0.1",
		"react-test-renderer": "19.3.1",
		"style-loader": "4.0.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"webpack": "5.112.2",
		"webpack-cli": "7.3.0",
		"webpack-dashboard": "3.3.8",
		"webpack-dev-server": "6.1.0"
	},
	"jest": {
		"testEnvironment": "<rootDir>/config/jest/jsdomWithFetchEnvironment.js",
		"transform": {
			"\\.[jt]sx?$": "babel-jest"
		},
		"setupFilesAfterEnv": [
			"<rootDir>/src/setupTests.ts"
		],
		"moduleNameMapper": {
			"\\.(css|less|scss|sass)$": "<rootDir>/config/jest/styleMock.js",
			"^entities$": "<rootDir>/config/jest/entitiesMock.js"
		},
		"coverageThreshold": {
			"global": {
				"branches": 70,
				"functions": 80,
				"lines": 80,
				"statements": 80
			}
		},
		"transformIgnorePatterns": [
			"node_modules/(?!axios)"
		],
		"testPathIgnorePatterns": [
			"<rootDir>/build/"
		],
		"coveragePathIgnorePatterns": [
			"src/reducers/",
			"src/helper/DownstreamServices.ts",
			"config/jest/"
		],
		"watchPathIgnorePatterns": [
			"/node_modules/"
		]
	}
}
